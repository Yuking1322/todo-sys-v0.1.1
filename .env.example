# Server
HOST=127.0.0.1
PORT=5173
DATA_BACKEND=json

# Optional: protect /api/sync/openclaw
OPENCLAW_SYNC_TOKEN=replace_with_a_strong_token

# Optional: protect mutating APIs (POST/PATCH/DELETE/PUT)
APP_WRITE_TOKEN=replace_with_a_strong_write_token

# Optional: external AI parser (OpenAI-compatible)
AI_API_BASE=
AI_API_KEY=
AI_MODEL=

# Optional: holiday providers
HOLIDAY_YEAR_API=https://timor.tech/api/holiday/year
HOLIDAY_FALLBACK_API=https://date.nager.at/api/v3/PublicHolidays
HOLIDAY_FETCH_TIMEOUT_MS=8000

# Optional: PostgreSQL (used when DATA_BACKEND=postgres)
# Prefer a single connection string:
# DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/todo_openclaw_sync
# Or use PG* variables:
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=
PGSSLMODE=disable

# Optional: Docker Compose defaults
POSTGRES_DB=todo_openclaw_sync
POSTGRES_USER=todo_user
POSTGRES_PASSWORD=replace_with_a_strong_db_password
